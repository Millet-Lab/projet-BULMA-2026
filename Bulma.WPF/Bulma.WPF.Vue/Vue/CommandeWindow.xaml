<Window x:Class="Bulma.WPF.Vue.Vue.CommandeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bulma.WPF.Vue.Vue"
        mc:Ignorable="d"
        Title="Gestion des commandes" Height="720" Width="920"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E7D32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                    <Setter Property="Foreground" Value="#C62828" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- une commande livrée s'affiche en vert : binding sur EstLivree, aucun code C# -->
        <Style x:Key="LigneCommande" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstLivree}" Value="True">
                    <Setter Property="Foreground" Value="#2E7D32" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Client :" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="420"
                      ItemsSource="{Binding Clients}"
                      DisplayMemberPath="NomComplet"
                      SelectedItem="{Binding ClientSelectionne, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,10,0,6" FontWeight="SemiBold" Text="{Binding ResumeClient}" />

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Commandes}"
                  SelectedItem="{Binding CommandeSelectionnee, Mode=TwoWay}"
                  RowStyle="{StaticResource LigneCommande}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="2*" />
                <DataGridTextColumn Header="Montant total" Binding="{Binding Montant}" Width="*" />
                <DataGridTextColumn Header="Livraison" Binding="{Binding Statut}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Marquer comme livrée" HorizontalAlignment="Left"
                Padding="16,6" Margin="0,10,0,0"
                IsEnabled="{Binding PeutMarquerLivree}"
                Click="BtnLivrer_Click" />

        <TextBlock Grid.Row="4" Margin="0,16,0,6" FontWeight="SemiBold" Text="{Binding EnteteCommande}" />

        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding Lignes}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produit" Binding="{Binding Nom}" Width="2*" />
                <DataGridTextColumn Header="Prix unitaire" Binding="{Binding Prix}" Width="*" />
                <DataGridTextColumn Header="Quantité" Binding="{Binding Quantite}" Width="*" />
                <DataGridTextColumn Header="Sous-total" Binding="{Binding SousTotal}" Width="*" />
                <DataGridTextColumn Header="" Binding="{Binding Remarque}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="6" Margin="0,8,0,0" HorizontalAlignment="Right" FontWeight="SemiBold"
                   Text="{Binding MontantCommande}" />

        <TextBlock Grid.Row="7" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="{Binding Message}" Style="{StaticResource MessageStyle}" />
    </Grid>
</Window>
