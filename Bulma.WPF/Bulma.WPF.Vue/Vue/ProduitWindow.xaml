<Window x:Class="Bulma.WPF.Vue.Vue.ProduitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bulma.WPF.Vue.Vue"
        mc:Ignorable="d"
        Title="Gestion des produits" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="BoutonSurSelection" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProduitSelectionne}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- message vert, ou rouge si c'est une erreur -->
        <Style x:Key="Message" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E7D32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                    <Setter Property="Foreground" Value="#C62828" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Type de produit :" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="cmbType" Width="200"
                      ItemsSource="{Binding Types}"
                      DisplayMemberPath="Libelle"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding TypeChoisi, Mode=TwoWay}" />
            <Button Content="Ajouter un produit" Padding="14,6" Margin="16,0,0,0" Click="BtnAjouterProduit_Click" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Produits}"
                  SelectedItem="{Binding ProduitSelectionne, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produit" Binding="{Binding Nom}" Width="2*" />
                <DataGridTextColumn Header="Détail" Binding="{Binding Detail}" Width="2*" />
                <DataGridTextColumn Header="Prix" Binding="{Binding Prix}" Width="*" />
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Nouveau stock :" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="80" Margin="0,0,12,0" Text="{Binding NouveauStock, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Modifier le stock" Style="{StaticResource BoutonSurSelection}" Click="BtnModifierStock_Click" />
            <Button Content="Supprimer le produit" Style="{StaticResource BoutonSurSelection}" Click="BtnSupprimer_Click" />
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Message}" Style="{StaticResource Message}" />
    </Grid>
</Window>
