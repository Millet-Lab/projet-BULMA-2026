<Window x:Class="Bulma.WPF.Vue.Vue.AjoutProduitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bulma.WPF.Vue.Vue"
        mc:Ignorable="d"
        Title="Ajouter un produit" Height="640" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Libelle">
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>

        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E7D32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                    <Setter Property="Foreground" Value="#C62828" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- visible seulement pour le type voulu : aucun code C# -->
        <Style x:Key="SeulementAlcool" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeChoisi}" Value="ALCOOL">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeulementBiere" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeChoisi}" Value="BIERE">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Type de produit" Style="{StaticResource Libelle}" />
            <ComboBox ItemsSource="{Binding Types}" DisplayMemberPath="Libelle" SelectedValuePath="Code"
                      SelectedValue="{Binding TypeChoisi, Mode=TwoWay}" />

            <TextBlock Text="Nom" Style="{StaticResource Libelle}" />
            <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />

            <TextBlock Text="Prix unitaire (€)" Style="{StaticResource Libelle}" />
            <TextBox Text="{Binding Prix, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Goût" Style="{StaticResource Libelle}" />
            <TextBox Text="{Binding Gout, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />

            <TextBlock Text="Quantité en stock" Style="{StaticResource Libelle}" />
            <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Style="{StaticResource SeulementAlcool}">
                <TextBlock Text="Degré d'alcool (%)" Style="{StaticResource Libelle}" />
                <TextBox Text="{Binding DegreAlcool, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Provenance" Style="{StaticResource Libelle}" />
                <TextBox Text="{Binding Provenance, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
            </StackPanel>

            <StackPanel Style="{StaticResource SeulementBiere}">
                <CheckBox Content="Bière avec alcool" Margin="0,12,0,0" IsChecked="{Binding EstAlcoolisee}" />
                <TextBlock Text="Récipient" Style="{StaticResource Libelle}" />
                <ComboBox ItemsSource="{Binding Recipients}" SelectedItem="{Binding RecipientChoisi}" />
            </StackPanel>

            <TextBlock Text="Image" Style="{StaticResource Libelle}" />
            <DockPanel>
                <Button Content="Parcourir…" DockPanel.Dock="Left" Padding="12,4" Margin="0,0,10,0"
                        Click="BtnParcourir_Click" />
                <TextBlock Text="{Binding NomImage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Image Source="{Binding CheminApercu}" Height="90" Margin="0,8,0,0" HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="Ajouter le produit" Padding="16,6" Margin="0,0,10,0" Click="BtnAjouter_Click" />
                <Button Content="Fermer" Padding="16,6" Click="BtnFermer_Click" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Message}"
                       Style="{StaticResource MessageStyle}" />
        </StackPanel>
    </ScrollViewer>
</Window>
